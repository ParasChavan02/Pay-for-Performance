# Server Configuration
PORT=3000
NODE_ENV=development

# PayPal Sandbox Credentials
# Obtain these from your PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (Optional - configure if using webhook signature validation)
PAYPAL_WEBHOOK_ID=

# Redirect URLs for Buyer Approval
PAYPAL_RETURN_URL=http://localhost:3000/api/payments/return
PAYPAL_CANCEL_URL=http://localhost:3000/api/payments/cancel

# Database Configuration (Optional: default uses SQLite persistent file in data/pay_for_performance.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/pay_for_performance
DATABASE_STORAGE_PATH=./data/pay_for_performance.json
